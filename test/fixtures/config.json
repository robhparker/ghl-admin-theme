{
  "schemaVersion": 1,
  "enabled": true,
  "agency": {
    "logoUrl": "",
    "logoAlt": "Test Agency",
    "logoMount": "sidebar",
    "theme": { "primary": "#0f766e" }
  },
  "locations": {
    "locA": {
      "name": "Location A",
      "logoUrl": "./fixtures/logos/loc-a.svg",
      "logoAlt": "Location A logo",
      "theme": {
        "primary": "#c2410c",
        "sidebarBg": "#1f2937",
        "sidebarText": "#f9fafb",
        "navActive": "#374151"
      },
      "buttons": {}
    },
    "locB": {
      "name": "Location B",
      "logoUrl": "./fixtures/logos/loc-b.svg",
      "theme": {
        "primary": "not-a-color",
        "sidebarBg": "#ffffff",
        "sidebarText": "#f5f5f5",
        "navActive": "#e5e7eb"
      },
      "buttons": {
        "sendInvite": false,
        "supportLink": { "label": "B Support" }
      }
    },
    "locC": {
      "name": "Location C",
      "logoUrl": "./fixtures/logos/missing.svg"
    }
  },
  "buttons": [
    {
      "id": "sendInvite",
      "label": "Send Invite",
      "icon": "send",
      "placement": "contact",
      "scope": "all",
      "action": {
        "type": "webhook",
        "url": "https://services.leadconnectorhq.com/hooks/TEST-HOOK",
        "extraFields": {
          "source": "ghlc-harness",
          "contactId": "SHOULD-NOT-WIN"
        },
        "cooldownMs": 3000
      }
    },
    {
      "id": "supportLink",
      "label": "Support",
      "icon": "external",
      "placement": "header",
      "scope": "all",
      "action": {
        "type": "link",
        "href": "https://example.test/support",
        "target": "_blank"
      }
    },
    {
      "id": "locOnlyLink",
      "label": "Location Settings",
      "icon": "link",
      "placement": "header",
      "scope": ["locA"],
      "action": {
        "type": "link",
        "href": "/v2/location/locA/settings"
      }
    },
    {
      "id": "badTypeBtn",
      "label": "Bad Type",
      "placement": "header",
      "scope": "all",
      "action": {
        "type": "script",
        "code": "alert(1)"
      }
    },
    {
      "id": "badHandlerBtn",
      "label": "Bad Handler",
      "placement": "contact",
      "scope": "all",
      "action": {
        "type": "handler",
        "handler": "nope"
      }
    },
    {
      "id": "copyIdBtn",
      "label": "Copy Contact ID",
      "icon": "mail",
      "placement": "contact",
      "scope": "all",
      "action": {
        "type": "handler",
        "handler": "copyContactId"
      }
    }
  ],
  "menus": [
    {
      "id": "harnessActions",
      "label": "Actions",
      "icon": "menu",
      "placement": "contact",
      "scope": ["locM"],
      "items": [
        {
          "id": "menuInvite",
          "label": "Send Invite (harness)",
          "icon": "send",
          "action": {
            "type": "webhook",
            "url": "https://services.leadconnectorhq.com/hooks/TEST-MENU",
            "cooldownMs": 5000,
            "extraFields": { "source": "ghlc-harness" }
          }
        },
        {
          "id": "menuConsent",
          "label": "Send consent (harness)",
          "icon": "mail",
          "requires": { "email": "real" },
          "action": {
            "type": "webhook",
            "url": "https://services.leadconnectorhq.com/hooks/TEST-CONSENT",
            "cooldownMs": 5000,
            "extraFields": { "source": "ghlc-harness" }
          }
        },
        {
          "id": "menuHub",
          "label": "Resend hub link (harness)",
          "icon": "mail",
          "action": {
            "type": "webhook",
            "url": "",
            "cooldownMs": 5000,
            "extraFields": { "source": "ghlc-harness" }
          }
        },
        {
          "id": "menuCopy",
          "label": "Copy contact ID",
          "icon": "copy",
          "action": {
            "type": "handler",
            "handler": "copyContactId"
          }
        }
      ]
    }
  ]
}
